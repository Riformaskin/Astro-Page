---
import '../styles/global.css';
import Header from '../components/Header.astro'; import ContactSection from '../components/ContactSection.astro'; import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const { title, description, canonical, image='/images/general/og.svg', noindex=false } = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.baseUrl).toString();
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><link rel="canonical" href={canonicalUrl}/><meta name="robots" content={noindex?'noindex,nofollow':'index,follow'}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:image" content={new URL(image,site.baseUrl)}/><meta property="og:url" content={canonicalUrl}/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={new URL(image,site.baseUrl)}/><title>{title}</title></head><body><Header/><main><slot/></main><ContactSection/><Footer/></body></html>
