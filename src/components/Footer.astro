---
import { navigation } from '../data/navigation'; import { site } from '../data/site';
---
<footer class="border-t border-line bg-ivory">
 <div class="container-page py-12 md:py-16">
  <div class="grid gap-10 md:grid-cols-3">
   <div><p class="text-lg font-semibold tracking-[.08em]">{site.name}</p><p class="mt-3 max-w-xs text-sm leading-6 text-cocoa/65">Studio für bewusste Hautpflege.</p></div>
   <nav aria-label="Footer Navigation"><p class="eyebrow mb-4 text-cocoa/60">Navigation</p><ul class="space-y-2 text-sm">{navigation.map(i=><li><a class="focus-ring hover:opacity-60" href={i.href}>{i.label}</a></li>)}<li><a class="focus-ring hover:opacity-60" href="#contact">Contact</a></li></ul></nav>
   <div><p class="eyebrow mb-4 text-cocoa/60">Rechtliches</p><ul class="space-y-2 text-sm"><li><a class="focus-ring hover:opacity-60" href="/impressum/">Impressum</a></li><li><a class="focus-ring hover:opacity-60" href="/datenschutz/">Datenschutz</a></li><li><a class="focus-ring hover:opacity-60" href={site.instagram} rel="noopener noreferrer" target="_blank">Instagram</a></li></ul></div>
  </div>
  <div class="mt-12 border-t border-line pt-5 text-xs text-cocoa/55">© {new Date().getFullYear()} {site.name} · {site.owner}</div>
 </div>
</footer>
