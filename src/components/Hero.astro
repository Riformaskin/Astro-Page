---
const { eyebrow, title, subtitle, cta } = Astro.props;
---
<section class="container-page pt-28 md:pt-24" aria-labelledby="hero-title">
 <div class="relative min-h-[72vh] overflow-hidden bg-cream">
  <img src="/images/hero/hero.jpeg" alt="Abstrakte, ruhige Beauty-Inszenierung als Platzhalter" class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" width="1600" height="1100" />
  <div class="absolute inset-0 bg-gradient-to-t from-ink/45 via-transparent to-transparent"></div>
  <div class="relative flex min-h-[72vh] flex-col justify-end p-7 text-ivory md:p-12 lg:p-16">
   <p class="eyebrow text-ivory/75">{eyebrow}</p><h1 id="hero-title" class="serif mt-4 max-w-4xl text-6xl leading-[.88] tracking-[-.025em] md:text-8xl lg:text-9xl">{title}</h1><p class="mt-6 max-w-xl text-base leading-7 text-ivory/85 md:text-lg">{subtitle}</p><a href="/treatments/" class="focus-ring mt-8 inline-flex w-fit border border-ivory px-6 py-3 text-sm transition-colors hover:bg-ivory hover:text-ink">{cta}</a>
  </div>
 </div>
</section>
