---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import SectionHeading from '../components/SectionHeading.astro'; import {content} from '../data/content'; import {treatments} from '../data/treatments';
const featured=treatments.filter(t=>t.featured);
---
<BaseLayout title="RIFORMA SKIN" description="Jeannine Sylvia Herdegen." >
 <Hero {...content.hero}/>
 <section class="container-page py-24 md:py-36"><SectionHeading eyebrow={content.concept.eyebrow} title={content.concept.title} intro={content.concept.intro}/><!--div class="mt-14 grid gap-8 md:grid-cols-2"--><p class="text-lg leading-8 text-cocoa/75">{content.concept.body}</p><!-- /div --></section>
 <section class="border-y border-line"><div class="container-page py-24 md:py-32"><SectionHeading eyebrow="Werte" title="Wofür Riformaskin steht."/><div class="mt-16 grid gap-px border border-line bg-line md:grid-cols-2">{content.values.map(v=><article class="bg-ivory p-8 md:p-10"><p class="text-xs tracking-[.18em] text-cocoa/40">{v.number}</p><h3 class="serif mt-8 text-4xl">{v.title}</h3><p class="mt-4 max-w-md leading-7 text-cocoa/70">{v.text}</p></article>)}</div></div></section>
</BaseLayout>
