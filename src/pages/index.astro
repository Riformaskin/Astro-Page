---
import BaseLayout from '../layouts/BaseLayout.astro'; import Hero from '../components/Hero.astro'; import SectionHeading from '../components/SectionHeading.astro'; import {content} from '../data/content'; import {treatments} from '../data/treatments';
const featured=treatments.filter(t=>t.featured);
---
<BaseLayout title="Riformaskin · Studio für bewusste Hautpflege" description="Riformaskin – individuelle Treatments und bewusste Hautpflege mit Jeannine Sylvia Herdegen." >
 <Hero {...content.hero}/>
 <section class="container-page py-24 md:py-36"><SectionHeading eyebrow={content.concept.eyebrow} title={content.concept.title} intro={content.concept.intro}/><div class="mt-14 grid gap-8 md:grid-cols-2"><p class="text-lg leading-8 text-cocoa/75">{content.concept.body}</p><div class="bg-nude/35 p-8 md:p-12"><p class="serif text-3xl leading-tight">Hautpflege darf präzise sein, ohne laut zu werden.</p></div></div></section>
 <section class="border-y border-line"><div class="container-page py-24 md:py-32"><SectionHeading eyebrow="Values" title="Wofür Riformaskin steht."/><div class="mt-16 grid gap-px border border-line bg-line md:grid-cols-2">{content.values.map(v=><article class="bg-ivory p-8 md:p-10"><p class="text-xs tracking-[.18em] text-cocoa/40">{v.number}</p><h3 class="serif mt-8 text-4xl">{v.title}</h3><p class="mt-4 max-w-md leading-7 text-cocoa/70">{v.text}</p></article>)}</div></div></section>
 <section class="container-page py-24 md:py-32"><div class="flex flex-col justify-between gap-10 md:flex-row md:items-end"><SectionHeading eyebrow="Treatments" title="Ausgewählte Treatments." intro="Ein erster Einblick in die Behandlungen von Riformaskin. Die Auswahl wird individuell auf die Haut abgestimmt."/><a class="focus-ring shrink-0 border-b border-ink pb-1 text-sm" href="/treatments/">Alle Treatments entdecken ↗</a></div><div class="mt-14 grid gap-5 md:grid-cols-3">{featured.map(t=><a href="/treatments/" class="group"><img src={t.image} alt={`Platzhalterbild für ${t.title}`} class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" loading="lazy" width="900" height="675"/><div class="mt-4"><h3 class="serif text-3xl">{t.title}</h3><p class="mt-1 text-sm text-cocoa/60">{t.shortDescription}</p></div></a>)}</div></section>
</BaseLayout>
